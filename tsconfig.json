{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "types": ["vite/client"],
    "noEmit": true,
    "paths": {
      // Type-checks against the web platform; vite.config.ts swaps in
      // src/platform/toss.ts for `--mode toss`. Both export the same shape.
      "#platform": ["./src/platform/web.ts"]
    }
  },
  "include": ["src"]
}
