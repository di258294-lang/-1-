# Apps in Toss build (`npm run build:toss`, `npm run dev:toss`).
# The appName registered in the Apps in Toss console. Used by
# apps-in-toss.config.ts and for intoss://<appName> share links. The Toss
# build refuses an empty name or one starting with TODO.
# Planned name; change it if the console registers a different one.
VITE_AIT_APP_NAME=hold-timing
